# EcoGranite-Advisor Environment Configuration
# Copy this template to .env and insert your real tokens.
# Do not commit .env to version control.

# Hugging Face Inference API Token (for IBM Granite 4.2 / 3.0 cloud inference)
# Leave empty if using local offline reasoning.
HUGGINGFACE_API_KEY=
HF_TOKEN=

# IBM WatsonX AI Credentials (optional)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
