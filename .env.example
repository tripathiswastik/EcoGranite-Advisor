# EcoGranite-Advisor Environment Credentials
# Copy this template to .env and insert your real tokens.
# Do not commit .env to version control.

# Hugging Face Inference API Token (for IBM Granite 4.2 / 3.0 cloud inference)
# Requires 'inference.serverless.write' permission on Hugging Face
HUGGINGFACE_API_KEY=hf_your_token_here
# Alternatively: HF_TOKEN=hf_your_token_here

# IBM WatsonX AI Credentials (optional)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
